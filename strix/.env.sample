# OPENAEV Environment Variables
# base URL to reach the OpenAEV server (must be routable from inside the container)
OPENAEV_URL=ChangeMe
# admin account API token from the OpenAEV server
OPENAEV_TOKEN=ChangeMe
# only required for multi-tenancy (Enterprise Edition), keep commented otherwise
#OPENAEV_TENANT_ID=ChangeMe

# INJECTOR Environment Variables
INJECTOR_ID=strix--ChangeMe
INJECTOR_NAME=Strix
INJECTOR_LOG_LEVEL=error

# STRIX LLM provider, configure by default to claude-sonnet-4-5 but can be any openAI, Antthropic, ollama or other. Check Strix documentation for the right configuration.
STRIX_LLM_MODEL=anthropic/claude-sonnet-4-5
STRIX_LLM_API_KEY=ChangeMe   # provider API key; model & base can also be overridden per-inject
# Optional OpenAI-compatible endpoint. Leave empty for the provider default.
#STRIX_LLM_API_BASE=
#STRIX_PERPLEXITY_API_KEY=ChangeMe

# STRIX scan behavior
STRIX_SCAN_MODE=deep
STRIX_MAX_TURNS=60
#STRIX_MAX_BUDGET_USD=10
# 0 = no injector wall-clock kill (agent stops on finish_scan / max-turns / max-budget).
# If >0, keep it below the platform's inject.execution.threshold.minutes.
STRIX_SCAN_TIMEOUT=0
STRIX_MAX_CONCURRENT_SCANS=2
