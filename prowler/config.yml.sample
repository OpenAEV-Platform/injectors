openaev:
  url: 'ChangeMe'
  token: 'ChangeMe'
  # Optional for multi-tenancy (Enterprise Edition)
  tenant_id: 'ChangeMe'

injector:
  id: 'ChangeMe'
  name: 'Prowler'
  log_level: 'error'

prowler:
  # Must be a nonblank absolute path. Existence is checked only before execution.
  executable_path: '/usr/local/bin/prowler'
