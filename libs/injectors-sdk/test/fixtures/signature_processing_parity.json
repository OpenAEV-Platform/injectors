{
  "description": "How the platform turns the signatures an injector posts into the signatures of its pending expectations, one case per test of the platform's SignatureOutputProcessorTest: the expectation_signatures an injector posts, and the expectations that end up signed, with their target and signatures. The inject declares a DETECTION and a PREVENTION expectation.",
  "platform_source": "openaev-api/src/test/java/io/openaev/output_processor/SignatureOutputProcessorTest.java (openaev-platform, main)",
  "cases": [
    {
      "source": "SignatureOutputProcessorTest.shouldResolveAgentTargetByInjectAndAgent",
      "expectation_signatures": {
        "targets": [
          {
            "signature_target": {
              "agent_id": "agent-1",
              "asset_id": "asset-1"
            },
            "signature_values": [
              {
                "expectation_type": "DETECTION",
                "values": [
                  {
                    "signature_type": "target_ipv4_address",
                    "signature_value": "10.0.0.5"
                  }
                ]
              }
            ]
          }
        ]
      },
      "signed": [
        {
          "type": "DETECTION",
          "agent": "agent-1",
          "asset": null,
          "asset_group": null,
          "signatures": [
            [
              "target_ipv4_address",
              "10.0.0.5"
            ]
          ]
        }
      ]
    },
